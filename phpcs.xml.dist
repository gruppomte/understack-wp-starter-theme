<?xml version="1.0"?>
<ruleset name="Theme">
    <description>PSR-12 formatting with the WordPress security and best-practice sniffs.</description>

    <file>app</file>
    <file>tests</file>
    <file>functions.php</file>
    <file>index.php</file>
    <file>woocommerce.php</file>

    <!-- Patterns are relative to the theme root so parent directory names never match. -->
    <exclude-pattern type="relative">^vendor/</exclude-pattern>
    <exclude-pattern type="relative">^node_modules/</exclude-pattern>
    <exclude-pattern type="relative">^includes/</exclude-pattern>
    <exclude-pattern type="relative">^public/</exclude-pattern>
    <exclude-pattern type="relative">^dist/</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.PHP.DevelopmentFunctions"/>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
    <rule ref="WordPress.PHP.NoSilencedErrors"/>
    <rule ref="WordPress.PHP.StrictInArray"/>
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>
        <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_fwrite"/>
    </rule>
    <rule ref="WordPress.WP.Capabilities"/>
    <rule ref="WordPress.WP.DeprecatedClasses"/>
    <rule ref="WordPress.WP.DeprecatedFunctions"/>
    <rule ref="WordPress.WP.DeprecatedParameters"/>
    <rule ref="WordPress.WP.DiscouragedFunctions"/>
    <rule ref="WordPress.WP.EnqueuedResources"/>
    <rule ref="WordPress.WP.GlobalVariablesOverride"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="understack-wp-starter"/>
            </property>
        </properties>
    </rule>
</ruleset>
