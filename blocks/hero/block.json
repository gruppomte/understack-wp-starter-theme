{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "acf/hero",
  "title": "Hero",
  "description": "Heading, text, call to action and image for the top of a page.",
  "category": "design",
  "icon": "cover-image",
  "keywords": ["hero", "banner", "intro"],
  "textdomain": "understack-wp-starter",
  "supports": {
    "align": ["wide", "full"],
    "anchor": true,
    "html": false,
    "jsx": false,
    "mode": true
  },
  "example": {
    "attributes": {
      "mode": "preview",
      "data": {
        "heading": "A clear headline for the page",
        "text": "One or two sentences that explain what this page offers.",
        "link": { "url": "#", "title": "Call to action", "target": "" },
        "image_position": "end"
      }
    }
  },
  "acf": {
    "mode": "preview",
    "renderTemplate": "render.php",
    "blockVersion": 3
  }
}
