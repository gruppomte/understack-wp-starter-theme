{
  "name": "understack-wp-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "npm run lint:js && npm run lint:php",
    "lint:js": "eslint .",
    "lint:php": "php vendor/squizlabs/php_codesniffer/bin/phpcs",
    "format": "prettier --write \"src/**/*.{js,css}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" vite.config.js eslint.config.js",
    "i18n": "node scripts/i18n.mjs",
    "check": "node scripts/check.mjs",
    "scan": "node scripts/scan.mjs",
    "setup": "node scripts/setup.mjs",
    "release": "node scripts/release.mjs",
    "acf:install": "node scripts/acf-install.mjs"
  },
  "dependencies": {
    "alpinejs": "^3.17.1",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "archiver": "^8.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
