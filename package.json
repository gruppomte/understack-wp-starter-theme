{
  "name": "understack-wp-starter",
  "version": "2027.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "npm run lint:js && npm run lint:php",
    "lint:js": "eslint .",
    "lint:php": "php vendor/squizlabs/php_codesniffer/bin/phpcs",
    "analyse": "php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:scripts": "node --test \"tests/scripts/*.test.mjs\"",
    "wp:playground": "node scripts/playground.mjs",
    "local:setup": "node scripts/local-setup.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "i18n": "node scripts/i18n.mjs",
    "check": "node scripts/check.mjs",
    "scan": "node scripts/scan.mjs",
    "setup": "node scripts/setup.mjs",
    "release": "node scripts/release.mjs",
    "acf:install": "node scripts/acf-install.mjs",
    "acf:json": "wp eval-file scripts/acf-json.php",
    "acf:json:sync": "wp eval-file scripts/acf-json.php sync"
  },
  "dependencies": {
    "alpinejs": "^3.17.1",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "archiver": "^8.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
