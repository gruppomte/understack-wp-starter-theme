{% extends 'layouts/base.twig' %}

{% block content %}
  <article id="post-{{ post.ID }}" class="{{ post.css_class|esc_attr }}">
    {% if post.password_required %}
      <div class="wrap py-16">{{ function('get_the_password_form', post.ID) }}</div>
    {% else %}
      <header class="wrap py-10 md:py-16">
        <div class="mx-auto max-w-3xl">
          {% include 'partials/breadcrumbs.twig' with { items: breadcrumbs() } only %}
          <h1 class="text-display font-semibold tracking-tight">{{ post.title }}</h1>
          <div class="mt-4">
            {% include 'partials/post-meta.twig' with { post: post } only %}
          </div>
        </div>
      </header>

      {% if post.thumbnail %}
        <div class="wrap mb-10">
          <div class="mx-auto max-w-3xl">
            {% include 'components/image.twig' with {
              image: post.thumbnail,
              size: 'large',
              class: 'w-full rounded-md',
              sizes: '(min-width: 48rem) 48rem, 100vw',
              priority: true
            } only %}
          </div>
        </div>
      {% endif %}

      <div class="wrap">
        <div class="content mx-auto max-w-3xl">{{ post.content }}</div>
      </div>

      {% set tags = post_terms(post, 'post_tag') %}
      {% if tags %}
        <footer class="wrap mt-10">
          <div class="mx-auto max-w-3xl">
            <h2 id="post-tags-title" class="sr-only">{{ __('Tags', 'understack-wp-starter') }}</h2>
            <ul class="flex flex-wrap gap-2" aria-labelledby="post-tags-title">
              {% for tag in tags %}
                <li><a class="inline-block rounded-full border border-line-strong px-3 py-1 text-sm hover:underline" href="{{ tag.link|esc_url }}">{{ tag.title }}</a></li>
              {% endfor %}
            </ul>
          </div>
        </footer>
      {% endif %}

      {% include 'partials/post-navigation.twig' with { post: post } only %}
      {% include 'partials/comments.twig' with {
        post: post,
        comments: comments|default(null),
        comments_pagination: comments_pagination|default('')
      } only %}
    {% endif %}
  </article>
{% endblock %}
