{% extends 'layouts/base.twig' %}

{% block content %}
  {% block archive_header %}
    {% include 'sections/page-header.twig' with { title: title, description: description } only %}
  {% endblock %}

  <div class="wrap pb-16">
    {% block archive_list %}
      {% if posts|length > 0 %}
        {% include 'components/post-grid.twig' with { posts: posts } only %}
      {% else %}
        {% include 'system/no-content.twig' with { search_form: show_search_form|default(true) } only %}
      {% endif %}
    {% endblock %}

    {% if pagination %}
      {% include 'components/pagination.twig' with { pagination: pagination } only %}
    {% endif %}
  </div>
{% endblock %}
