{% extends 'layouts/base.twig' %}

{% block content %}
  {% block archive_header %}
    {% include 'sections/page-header.twig' with { title: title, description: description } only %}
  {% endblock %}

  <div class="wrap pb-16">
    {% block archive_list %}
      {% if posts|length > 0 %}
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-animate-stagger>
          {% for item in posts %}
            {% include 'components/card.twig' with { post: item } only %}
          {% endfor %}
        </div>
      {% else %}
        {% include 'system/no-content.twig' %}
      {% endif %}
    {% endblock %}

    {% if pagination %}
      {% include 'components/pagination.twig' with { pagination: pagination } only %}
    {% endif %}
  </div>
{% endblock %}
