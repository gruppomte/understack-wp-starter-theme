{% set field_id = 'search-field-' ~ (id|default('main')) %}
<form role="search" method="get" action="{{ site.link|esc_url }}" class="flex gap-2">
  <label for="{{ field_id|esc_attr }}" class="sr-only">{{ __('Search', 'understack-wp-starter') }}</label>
  <input
    id="{{ field_id|esc_attr }}"
    class="field w-full"
    type="search"
    name="s"
    value="{{ function('get_search_query') }}"
    required
  >
  <button type="submit" class="btn btn-primary">
    {% include 'components/icon.twig' with { name: 'search', class: 'size-4' } only %}
    {{ __('Search', 'understack-wp-starter') }}
  </button>
</form>
