<footer class="site-footer mt-auto border-t border-line">
  <div class="wrap flex flex-col gap-8 py-10 md:flex-row md:justify-between">
    <div class="max-w-md">
      <p class="font-semibold">{{ site.name }}</p>
      {% if options.footer_text %}
        <div class="mt-2 text-sm text-ink-muted">{{ options.footer_text }}</div>
      {% endif %}
    </div>

    {% if menus.footer %}
      <nav aria-label="{{ __('Footer', 'understack-wp-starter')|esc_attr }}">
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {% for item in menus.footer.items %}
            <li><a class="hover:underline" href="{{ item.link|esc_url }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}

    {% if options.social_links %}
      <ul class="flex flex-wrap gap-4 text-sm" aria-label="{{ __('Social profiles', 'understack-wp-starter')|esc_attr }}">
        {% for link in options.social_links %}
          <li>
            <a class="hover:underline" href="{{ link.url }}" target="_blank" rel="noopener">
              {{ link.label|e }}
              <span class="sr-only">{{ __('(opens in a new tab)', 'understack-wp-starter') }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>

  <div class="wrap pb-6 text-sm text-ink-muted">
    <p>&copy; {{ 'now'|date('Y') }} {{ site.name }}</p>
  </div>
</footer>
